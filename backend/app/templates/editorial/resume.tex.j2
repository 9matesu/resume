% Standard ATS Resume Template — AutoJob Studio
% Layout editorial limpo de alta compatibilidade ATS, PT/EN automático
%
\documentclass[a4paper,10pt]{article}

% --- PACOTES: BASE / IDIOMA ---
\usepackage[utf8]{inputenc}
\usepackage[T1]{fontenc}
\usepackage{lmodern}
<% if lang == 'en' -%>
\usepackage[english]{babel}
<%- else -%>
\usepackage[portuguese]{babel}
<%- endif %>

% --- PACOTES: LAYOUT / TIPOGRAFIA ---
\usepackage{geometry}
\usepackage{parskip}
\usepackage{microtype}
\usepackage{enumitem}
\usepackage{titlesec}
\usepackage{array}
\usepackage{tabularx}

% --- PACOTES: LINKS / BOOKMARKS ---
\usepackage{hyperref}
\usepackage{bookmark}
\usepackage{xurl}

% --- CONFIGURAÇÃO: MARGENS / ESPAÇAMENTO ---
\geometry{top=1.3cm, bottom=1.3cm, left=1.4cm, right=1.4cm}
\setcounter{secnumdepth}{0}
\setlist[itemize]{
    leftmargin=1.1em,
    itemsep=0.18em,
    topsep=0.2em,
    parsep=0em,
    partopsep=0em
}

\pagestyle{empty}

% --- CONFIGURAÇÃO: METADADOS / LINKS ---
\hypersetup{
    pdftitle={CV << personal.get('name','') | esc >>},
    pdfauthor={<< personal.get('name','') | esc >>},
    colorlinks=true,
    linkcolor=black,
    urlcolor=black,
    citecolor=black,
    bookmarksdepth=2
}

% --- CONFIGURAÇÃO: TÍTULOS ---
\titleformat{\section}
{\Large\bfseries}
{}
{0em}
{}
[\titlerule\vspace{0.5ex}]
\titlespacing*{\section}{0pt}{0.9em}{0.4em}

\titleformat{\subsection}
{\normalsize\bfseries}
{}
{0em}
{}
\titlespacing*{\subsection}{0pt}{0.35em}{0.15em}

\newcounter{cventry}
\newcommand{\cventry}[4]{%
    \refstepcounter{cventry}%
    \phantomsection%
    \pdfbookmark[2]{#1}{cventry-\thecventry}%
    \noindent\begin{tabularx}{\textwidth}{@{}>{\raggedright\arraybackslash}X >{\raggedleft\arraybackslash}X@{}}
    \textbf{#1} & #2 \\
    \textit{#3} & \textit{#4} \\
    \end{tabularx}%
    \vspace{-0.3em}
}

% --- INÍCIO DO DOCUMENTO ---
\begin{document}

% --- CABEÇALHO ---
\begin{center}
    {\LARGE \textbf{<< personal.get('name','') | esc >>}}
    \\ [0.12cm]
    << contact_line >>
\end{center}
\vspace{0.2cm}

<% if lang == 'en' -%>
<%- set L = {'summary': 'Professional Summary', 'leadership': 'Leadership Activities',
             'experience': 'Experience', 'skills': 'Technical Skills',
             'education': 'Education', 'projects': 'Projects',
             'certifications': 'Certifications', 'technical': 'Technologies',
             'languages': 'Languages'} -%>
<%- else -%>
<%- set L = {'summary': 'Resumo Profissional', 'leadership': 'Atividades de Liderança',
             'experience': 'Experiência Profissional', 'skills': 'Habilidades Técnicas',
             'education': 'Formação Acadêmica', 'projects': 'Projetos',
             'certifications': 'Certificações', 'technical': 'Tecnologias',
             'languages': 'Idiomas'} -%>
<%- endif %>

<#
  Ordem das seções. O editor visual envia resume.layout.sections na ordem em
  que o usuário arrastou; `visible: false` remove a seção do PDF. Sem layout,
  a ordem abaixo é a padrão. Tipos desconhecidos são ignorados.
#>
<% set default_order = ['summary', 'experience', 'leadership', 'education',
                        'projects', 'skills', 'certifications'] -%>
<% set ns = namespace(order=[], hidden=[]) -%>
<% for s in ((resume.layout or {}).get('sections') or []) -%>
<% if s.get('type') in default_order -%>
<% if s.get('visible', True) -%>
<% if s.get('type') not in ns.order -%><% set ns.order = ns.order + [s.get('type')] -%><% endif -%>
<% else -%>
<% if s.get('type') not in ns.hidden -%><% set ns.hidden = ns.hidden + [s.get('type')] -%><% endif -%>
<% endif -%>
<% endif -%>
<% endfor -%>
<% for t in default_order -%>
<% if t not in ns.order and t not in ns.hidden -%><% set ns.order = ns.order + [t] -%><% endif -%>
<% endfor -%>

<% macro sec_summary() -%>
<% if resume.summary -%>
\section{<< L['summary'] >>}
<< resume.summary | esc >>

<% endif -%>
<% endmacro -%>

<% macro sec_entries(key, title) -%>
<% if resume[key] -%>
\section{<< title >>}
<% for entry in resume[key] -%>
\cventry{<< (entry.get('company') or entry.get('org') or entry.get('institution') or entry.get('name') or entry.get('role') or entry.get('title') or '') | esc >>}{<< (entry.get('location') or '') | esc >>}{<< (entry.get('role') or entry.get('title') or entry.get('degree') or entry.get('course') or '') | esc >>}{<< entry | dates | esc >>}
<% set bl = entry | bullets -%>
<% if bl -%>
\begin{itemize}
<% for b in bl -%>
    \item << b | esc >>
<% endfor -%>
\end{itemize}
<% elif entry.get('description') -%>
\begin{itemize}
    \item << entry['description'] | esc >>
\end{itemize}
<% endif -%>
\vspace{0.2em}
<% endfor -%>

<% endif -%>
<% endmacro -%>

<% macro sec_skills() -%>
<% if resume.skills or resume.languages -%>
\section{<< L['skills'] >>}
\begin{itemize}
<% if resume.skills -%>
    \item \textbf{<< L['technical'] >>:} << resume.skills | names | esc >>
<% endif -%>
<% if resume.languages -%>
    \item \textbf{<< L['languages'] >>:} << resume.languages | names | esc >>
<% endif -%>
\end{itemize}

<% endif -%>
<% endmacro -%>

<% macro sec_certifications() -%>
<% if resume.certifications -%>
\section{<< L['certifications'] >>}
\begin{itemize}
<% for c in resume.certifications -%>
    \item << (c.get('name') or '') | esc >>
<% endfor -%>
\end{itemize}

<% endif -%>
<% endmacro -%>

<% for key in ns.order -%>
<% if key == 'summary' -%><< sec_summary() >>
<% elif key == 'experience' -%><< sec_entries('experience', L['experience']) >>
<% elif key == 'leadership' -%><< sec_entries('leadership', L['leadership']) >>
<% elif key == 'education' -%><< sec_entries('education', L['education']) >>
<% elif key == 'projects' -%><< sec_entries('projects', L['projects']) >>
<% elif key == 'skills' -%><< sec_skills() >>
<% elif key == 'certifications' -%><< sec_certifications() >>
<% endif -%>
<% endfor -%>

\end{document}
